generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  password     String
  name         String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  isAdmin      Boolean       @default(false)
  permissions  Json?
  roles        Json?
  googleId     String?       @unique
  provider     String?       @default("local")
  chatSessions ChatSession[]
}

model SystemLog {
  id        String   @id @default(uuid())
  level     String
  message   String
  metadata  Json?
  createdAt DateTime @default(now())
}

model SystemConfig {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

model ChatSession {
  id              String    @id @default(uuid())
  userId          String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  tagline         String    @default("Explore new destination")
  title           String    @default("Plan your trip")
  save            Boolean   @default(true)

  disasterSummary String?
  holidaySummary  String?
  tripCountry     String?
  tripEnd         String?
  tripStart       String?

  weatherJson     Json?
  weatherSummary  String?             

  user        User           @relation(fields: [userId], references: [id])
  messages    Message[]
  itineraries TripItinerary[]

  tripContext TripContext?
}

model TripContext {
  id                String   @id @default(uuid())
  sessionId         String   @unique

  city              String?
  countryCode       String?
  tripStart         DateTime?
  tripEnd           DateTime?

  holidaySummary    String?
  disasterSummary   String?

  weatherJson       Json?
  weatherSummary    String?

  hotelName         String?
  hotelBudget       String?
  flightInfo        String?
  groundTransport   String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  chatSession       ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model TripItinerary {
  id          String   @id @default(uuid())
  sessionId   String
  dayNumber   Int
  time        String?
  title       String
  description String?
  location    String?
  price       String?

  chatSession ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sessionId])
}

model Message {
  id          String      @id @default(uuid())
  sessionId   String
  role        String
  content     String
  toolCalls   Json?
  toolCallId  String?
  createdAt   DateTime    @default(now())

  chatSession ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model IpWhitelist {
  id          String   @id @default(uuid())
  ipAddress   String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  active      Boolean  @default(true)
}
